# NVIDIA Proxy Stack Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# NVIDIA NGC API Key (REQUIRED)
# Get your API key from: https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=your-ngc-api-key-here

# Admin UI authentication token (optional)
# Set to enable Bearer token auth on /admin endpoints
ADMIN_TOKEN=your-secure-admin-token-here

# Grafana admin password
GRAFANA_PASSWORD=admin

# Optional: Custom ports (uncomment to override)
# NVIDIA_PROXY_PORT=8089
# HYBRID_PROXY_PORT=3456
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3000

# Optional: Log levels
# NVIDIA_PROXY_LOG_LEVEL=INFO
# HYBRID_PROXY_LOG_LEVEL=INFO

# Optional: Model configuration (overrides docker-compose.yml)
# NVIDIA_PROXY_NIM_INSTANCES__0__BASE_URL=http://nim:8000
# NVIDIA_PROXY_NIM_INSTANCES__0__MODELS=["meta/llama-3.1-70b-instruct"]
